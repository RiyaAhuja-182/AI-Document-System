# Production Environment Variables Template
# Copy this to .env.production and update with your production values
# DO NOT commit .env.production - it's gitignored for security

# ============================================
# Docling Service (Railway Deployment)
# ============================================
# Update this with your Railway URL after deploying Docling service
# Example: https://document-chat-system-production.up.railway.app
DOCLING_SERVICE_URL="https://your-docling-service.up.railway.app"
DOCLING_ENABLED=true
DOCLING_TIMEOUT=30000

# ============================================
# Core Application URLs
# ============================================
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_API_URL="https://your-domain.vercel.app/api"
NODE_ENV="production"

# ============================================
# Database (Supabase Production)
# ============================================
DATABASE_URL="REPLACE_WITH_YOUR_DATABASE_URL_VALUE"

# ============================================
# Authentication (Clerk Production Keys)
# ============================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="REPLACE_WITH_YOUR_NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY_VALUE"
CLERK_SECRET_KEY="REPLACE_WITH_YOUR_CLERK_SECRET_KEY_VALUE"
CLERK_WEBHOOK_SECRET="REPLACE_WITH_YOUR_CLERK_WEBHOOK_SECRET_VALUE"

# ============================================
# File Storage (Supabase Production)
# ============================================
NEXT_PUBLIC_SUPABASE_URL="REPLACE_WITH_YOUR_NEXT_PUBLIC_SUPABASE_URL_VALUE"
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_WITH_YOUR_NEXT_PUBLIC_SUPABASE_ANON_KEY_VALUE"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY_VALUE"

# ============================================
# Background Jobs (Inngest Production)
# ============================================
INNGEST_EVENT_KEY="your-production-event-key"
INNGEST_SIGNING_KEY="REPLACE_WITH_YOUR_INNGEST_SIGNING_KEY_VALUE"

# ============================================
# AI Providers (Production Keys)
# ============================================
OPENROUTER_API_KEY="REPLACE_WITH_YOUR_OPENROUTER_API_KEY_VALUE"
OPENAI_API_KEY="REPLACE_WITH_YOUR_OPENAI_API_KEY_VALUE"
ANTHROPIC_API_KEY="REPLACE_WITH_YOUR_ANTHROPIC_API_KEY_VALUE"
IMAGEROUTER_API_KEY="REPLACE_WITH_YOUR_IMAGEROUTER_API_KEY_VALUE"

# ============================================
# Vector Database (Pinecone Production)
# ============================================
PINECONE_API_KEY="REPLACE_WITH_YOUR_PINECONE_API_KEY_VALUE"
PINECONE_ENVIRONMENT="us-east-1"
PINECONE_INDEX_NAME="document-chat-index"

# ============================================
# Billing (Stripe Production)
# ============================================
STRIPE_SECRET_KEY="REPLACE_WITH_YOUR_STRIPE_SECRET_KEY_VALUE"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="REPLACE_WITH_YOUR_NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_VALUE"
STRIPE_WEBHOOK_SECRET="REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET_VALUE"

# ============================================
# Security Keys (Generate new for production!)
# ============================================
ENCRYPTION_KEY="your-production-encryption-key"
INTERNAL_API_KEY="your-production-internal-api-key"
CRON_SECRET="your-production-cron-secret"
JWT_SECRET="your-production-jwt-secret"
NEXTAUTH_SECRET="your-production-nextauth-secret"
